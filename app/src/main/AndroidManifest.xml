<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- SessionService keeps the process in the foreground while the
         compositor runs; specialUse is the correct foregroundServiceType
         on Android 14+ (none of the standard types fit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ExternalWaylandService identifies its caller by uid and package
         name (see callerAllowed). Package visibility filtering otherwise
         hides com.termux from getPackagesForUid on Android 11+. -->
    <queries>
        <package android:name="com.termux" />
        <!-- Debug-only fallback so the helper can run from `adb shell`. -->
        <package android:name="com.android.shell" />
        <!-- The external apps allowlist dialog lists launchable apps
             without QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TawcApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Tawc"
        android:extractNativeLibs="true">

        <!-- Transparent trampoline in a separate process, used by
             AppRestart to relaunch MainActivity after the app process is
             killed (Android 14 blocks an alarm/broadcast from bringing a
             singleTask activity back directly). -->
        <activity
            android:name=".RestartActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:process=":restart"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CompositorActivity hosts one window. documentLaunchMode
             "intoExisting", taskAffinity="" and a unique
             tawc://activity/<id> URI per launch makes Android treat each
             activityId as its own "document", giving each window a
             separate card in recents. The launch path is the reverse-JNI
             spawnActivity callback in NativeBridge.kt. -->
        <activity
            android:name=".compositor.CompositorActivity"
            android:exported="false"
            android:theme="@style/Theme.Tawc.Compositor"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <service
            android:name=".compositor.CompositorService"
            android:exported="false" />

        <!-- Exported fd source for out-of-uid Wayland clients (Termux).
             Access is gated in ExternalWaylandService.callerAllowed, not
             by a permission: the app_process caller has no manifest. -->
        <service
            android:name=".compositor.ExternalWaylandService"
            android:exported="true" />

        <activity
            android:name=".licenses.LicensesActivity"
            android:exported="false"
            android:label="@string/title_licenses" />

        <activity
            android:name=".licenses.LicenseSectionActivity"
            android:exported="false"
            android:label="@string/title_licenses" />

        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="wayland_compositor" />
        </service>

    </application>

</manifest>
