<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The compositor draws its own surface and never inflates Material
         widgets, so it stays on the device-default theme. -->
    <style name="Theme.Tawc.Compositor" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
