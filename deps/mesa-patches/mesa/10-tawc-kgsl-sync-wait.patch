+/* tawc-fork: NDK 27's android-stub libsync no longer resolves sync_wait
+ * at link time for this build, so keep a local poll-based implementation. */
+#include <poll.h>
+static inline int
+tawc_sync_wait(int fd, int timeout)
+{
+   struct pollfd pfd = { .fd = fd, .events = POLLIN };
+   int ret;
+   do {
+      ret = poll(&pfd, 1, timeout);
+   } while (ret == -1 && errno == EINTR);
+   if (ret > 0 && (pfd.revents & (POLLERR | POLLNVAL))) {
+      errno = EINVAL;
+      return -1;
+   }
+   if (ret == 0) {
+      errno = ETIME;
+      return -1;
+   }
+   return ret > 0 ? 0 : -1;
+}
